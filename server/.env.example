PORT=5000
MONGO_URI=mongodb://localhost:27017/smart-agri-rental
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Smart Agricultural Rental Platform" <no-reply@smartagri.com>

# Weather API (OpenWeatherMap)
# Required for weather-aware smart scheduling. Uses latitude+longitude.
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Razorpay Payment Gateway
# RAZORPAY_KEY_ID is public (safe to expose to frontend via API)
# RAZORPAY_KEY_SECRET must NEVER be exposed to the frontend
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMS Notifications (Twilio) - optional
# When unset, a development mock SMS provider logs messages instead.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_from_number